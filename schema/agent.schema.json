{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/yniantongtian-oss/hardware-agency-agents/schema/agent.schema.json",
  "title": "Hardware engineering agent",
  "description": "Frontmatter for one hardware-engineering agent prompt. The CI validator enforces this schema.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "name", "description", "summary", "domain", "kind", "tools"],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 3,
      "maxLength": 64,
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "description": "Stable slug. Chinese pairs use the English id plus -zh."
    },
    "name": {
      "type": "string",
      "minLength": 2,
      "maxLength": 120,
      "description": "Role title a person would search for."
    },
    "description": {
      "type": "string",
      "minLength": 40,
      "maxLength": 500,
      "description": "Trigger text: when an agent host should select this role."
    },
    "summary": {
      "type": "string",
      "minLength": 8,
      "maxLength": 300,
      "description": "One catalog line describing the role boundary."
    },
    "domain": {
      "type": "string",
      "enum": [
        "pcb-board",
        "reliability-emc-safety",
        "embedded",
        "mixed-signal",
        "test-validation",
        "power",
        "chip-platform",
        "communications"
      ]
    },
    "kind": {
      "type": "string",
      "enum": ["role", "review"]
    },
    "tools": {
      "type": "array",
      "minItems": 3,
      "maxItems": 6,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "adc-reference",
          "analog-front-end",
          "assembly-process",
          "battery-profile",
          "bms-sensing",
          "boot-config",
          "boundary-scan",
          "boundary-test",
          "can-rs485",
          "cell-balancing",
          "certification-dossier",
          "clock-reset",
          "current-sense",
          "datasheet-review",
          "ddr-bringup",
          "decapsulation",
          "derating",
          "design-review",
          "dfa",
          "dfm",
          "electronic-load",
          "emc-scan",
          "emi-debug",
          "environmental-chamber",
          "esd-test",
          "ethernet-phy",
          "evt-dvt",
          "fabrication-notes",
          "failure-analysis",
          "field-solver",
          "filter-design",
          "fixture-design",
          "flash-boot",
          "fmea",
          "footprint-check",
          "footprint-library",
          "fpga-config",
          "gate-drive",
          "grounding",
          "high-speed-io",
          "hipot",
          "impedance-control",
          "industrial-bus",
          "instrument-control",
          "insulation-coordination",
          "interface-protection",
          "inverter-bridge",
          "io-level",
          "io-module",
          "isolation",
          "issue-tracker",
          "lab-notebook",
          "length-matching",
          "logic-analyzer",
          "logic-level",
          "loop-compensation",
          "loss-analysis",
          "magnetics",
          "mcu-minimum-system",
          "microscope",
          "mtbf",
          "near-field-probe",
          "noise-analysis",
          "oscilloscope",
          "padstack",
          "panelization",
          "pcb-layout",
          "peripheral-interface",
          "pmic-sequencing",
          "power-budget",
          "power-conversion",
          "power-integrity",
          "power-on-debug",
          "power-tree",
          "programmable-logic",
          "protection-circuit",
          "reference-design",
          "relay-drive",
          "rf-matching",
          "safety-report",
          "safety-spacing",
          "schematic-capture",
          "signal-integrity",
          "sleep-current",
          "smt-process",
          "spectrum-analyzer",
          "stackup",
          "surge-protection",
          "swd-jtag",
          "test-plan",
          "thermal-chamber",
          "thermal-design",
          "timing-analysis",
          "transmission-line",
          "tvs-selection",
          "usb-signal",
          "validation-plan",
          "vibration-test",
          "vna",
          "wide-temperature"
        ]
      }
    },
    "color": {
      "type": "string",
      "enum": [
        "amber",
        "blue",
        "brown",
        "cyan",
        "green",
        "indigo",
        "light-blue",
        "lime",
        "magenta",
        "orange",
        "purple",
        "red",
        "sky",
        "slate",
        "steel",
        "teal",
        "violet",
        "yellow"
      ]
    }
  }
}
